{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SaveSync",
  "version": "0.1.0",
  "identifier": "app.savesync.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SaveSync",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://savesync-cover.localhost savesync-cover:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Local-first game save versioning and sync",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": ["icons/cartridge-insert.wav", "icons/cartridge-eject.wav"]
  }
}
